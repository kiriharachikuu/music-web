# 生产环境变量（next build 时注入到客户端）
#
# API base：直连后端 Cloudflare 节点，绕过 EdgeOne Pages 的 /api/* 504 问题
NEXT_PUBLIC_API_BASE=https://xtmusicapi.chikuu.top/api

# 管理后台地址（如有独立域名，否则保持相对路径）
NEXT_PUBLIC_ADMIN_URL=https://www.xingtone.site

# 当前应用版本（与 music-twa/app/build.gradle.kts 同步）
NEXT_PUBLIC_APP_VERSION=1.4.3
NEXT_PUBLIC_APP_VERSION_CODE=14
